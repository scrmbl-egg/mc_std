/// Base parameters for the `std:aabb/` module functions.
struct AabbCastParametersBase {
    /// Selector of the entity (or entities) whose collider(s) will trigger the
    /// command execution if they are inside the bounding box.
    entity_selector: #[entity] #[selector] string,

    /// Command that will be executed when the bounding box detects a specified
    /// entity.
    on_detection_command: #[command(max_length=32500)] string,
}


/// Parameters of the `std:aabb/cast_centered` function.
struct AabbCastCenteredParameters {
    /// 3D vector that describes the size of the box.
    size: [double @ 0..] @ 3,

    ...AabbCastParametersBase,
}


/// Parameters of the `std:aabb/cast_absolute` function.
struct AabbCastAbsoluteParameters {
    /// 3D vector that describes the coordinate where the origin corner of the
    /// box will be.
    origin: [double] @ 3,

    /// 3D vector that describes the coordinate where the end corner of the box
    /// will be.
    end: [double] @ 3,

    ...AabbCastParametersBase,
}
