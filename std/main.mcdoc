dispatch minecraft:storage[std:main] to MainStorage


/// mc_std's `std:main` storage struct.
struct MainStorage {
    /// Null location for discarding function outputs. Whatever is stored here
    /// is bound to be replaced, and eventually, at the end of the tick, be
    /// removed.
    ///
    /// This location is a datapack equivalent of UNIX's `/dev/null` or
    /// Windows's `nul`.
    ///
    /// Example:
    ///
    /// ```mcfunction
    /// # function returns 1 since number has a decimal part, but since we
    /// # don't want the decimal part itself, we send it to `std:main null`.
    /// function std:math/decimal_part { \
    ///     x:20.3, \
    ///     out_storage:"std:main", \
    ///     out_value:"null", \
    /// }
    /// ```
    null?: any,

    /// Global variables of the datapack.
    vars: struct GlobalVariables {
        /// Determines whether reload message appears.
        show_reload_message: boolean,
    },

    /// Constants of the datapack.
    consts: struct Constants {
        /// Constants related to the different data types that Minecraft.
        types: struct McTypeInfoConstants {
            /// Constants related to the `byte` (8-bit signed integer) Minecraft
            /// type.
            "byte": struct McByteTypeInfo {
                /// `true`/`1b`.
                ///
                /// See the `consts.types.string.true` constant.
                "true": boolean,

                /// `false`/`0b`.
                ///
                /// See the `consts.types.string.false` constant.
                "false": boolean,

                ...McIntegerTypeInfo<byte>,
            },

            /// Constants related to the `short` (16-bit signed integer)
            /// Minecraft type.
            "short": McIntegerTypeInfo<short>,

            /// Constants related to the `int` (32-bit signed integer) Minecraft
            /// type.
            "int": McIntegerTypeInfo<int>,

            /// Constants related to the `long` (64-bit signed integer)
            /// Minecraft type.
            "long": McIntegerTypeInfo<long>,

            /// Constants related to the `float` (32-bit floating-point number)
            /// Minecraft type.
            "float": McFloatingTypeInfo<float>,

            /// Constants related to the `double` (64-bit floating-point number)
            /// Minecraft type.
            "double": McFloatingTypeInfo<double>,

            /// Constants related to the int array (array of signed 8-bit
            /// integers) Minecraft type.
            "byte_array": McArrayTypeInfo,

            /// Constants related to the `string` (sequence of UTF-8 characters)
            /// Minecraft type.
            "string": struct McStringTypeInfo {
                /// `true` as `string`.
                ///
                /// Useful for macros that are placed when a `boolean`
                /// command keyword is needed.
                ///
                /// Example:
                /// ```mcfunction
                /// $gamerule locator_bar $(value)
                /// ```
                /// If we use `true` as an argument we get a syntax error
                /// because it is passed as a `byte`:
                /// ```mcfunction
                /// # ERROR!
                /// gamerule locator_bar 1b
                /// ```
                /// ...but if `"true"` is used as argument, the macro is
                /// evaluated correctly:
                /// ```mcfunction
                /// # works!
                /// gamerule locator_bar true
                /// ```
                "true": string,

                /// `false` as `string`.
                ///
                /// Useful for macros that are placed when a `boolean`
                /// command keyword is needed.
                ///
                /// Example:
                /// ```mcfunction
                /// $gamerule locator_bar $(value)
                /// ```
                /// If we use `false` as an argument we get a syntax error
                /// because it is passed as a `byte`:
                /// ```mcfunction
                /// # ERROR!
                /// gamerule locator_bar 1b
                /// ```
                /// ...but if `"false"` is used as argument, the macro is
                /// evaluated correctly:
                /// ```mcfunction
                /// # works!
                /// gamerule locator_bar false
                /// ```
                "false": string,

                /// Size of a single `string` character in bytes.
                character_size: int @ 1..,

                ...McTypeInfo,
            },

            /// Constants related to the compound (unordered list of
            /// attribute-value pairs) data type.
            "nbt_compound": McTypeInfo,

            /// Constants related to the list (ordered list) Minecraft type.
            "list": McTypeInfo,

            /// Constants related to the int array (array of signed 32-bit
            /// integers) Minecraft type.
            "int_array": McArrayTypeInfo,

            /// Constants related to the int array (array of signed 64-bit
            /// integers) Minecraft type.
            "long_array": McArrayTypeInfo,
        },

        /// Math constants, series, and tables.
        math: struct MathConstants {
            /// Ratio of a circle's circumference to its diameter.
            pi: double,

            /// Ratio of a circle's circumference to its radius (`pi` * 2).
            tau: double,

            /// Golden ratio.
            phi: double,

            /// Base of the natural logarithm, and exponential function.
            euler: double,

            /// Natural logarithm of 2.
            ln_2: double,

            /// Natural logarithm of 10.
            ln_10: double,

            /// Square root of 2.
            sqrt_2: double,

            /// Square root of 3.
            sqrt_3: double,

            /// Conversion factor from degrees to radians.
            degrees_to_radians: double,

            /// Conversion factor from radians to degrees.
            radians_to_degrees: double,

            /// Lookup array for `int` factorials. If a positive index `n` is
            /// used to look up an element of this array, the returned number is
            /// the `n`th factorial number.
            ///
            /// It is recommended to use the `std:math/int_factorial` function
            /// for proper validation and error printing.
            int_factorial_lookup: int[] @ 13,

            /// Lookup array for `long` factorials. If a positive index `n` is
            /// used to look up an element of this array, the returned number is
            /// the `n`th factorial number.
            ///
            /// It is recommended to use the `std:math/long_factorial` function
            /// for proper validation and error printing.
            long_factorial_lookup: long[] @ 21,
        }
    }
}


/// General type information struct.
struct McTypeInfo {
    /// Name of the type.
    name: string,

    /// Integer tag of the type.
    ///
    /// See: https://minecraft.wiki/w/NBT_format#TAG_definition
    type_tag: enum(int) McTypeTag {
        /// Tag for `byte`s.
        Byte = 1,

        /// Tag for `short`s.
        Short = 2,

        /// Tag for `int`s.
        Int = 3,

        /// Tag for `long`s.
        Long = 4,

        /// Tag for `float`s.
        Float = 5,

        /// Tag for `double`s.
        Double = 6,

        /// Tag for `byte` arrays.
        Byte_Array = 7,

        /// Tag for `string`s.
        String = 8,

        /// Tag for lists.
        List = 9,

        /// Tag for compounds.
        Compound = 10,

        /// Tag for `int` arrays.
        Int_Array = 11,

        /// Tag for `long` arrays.
        Long_Array = 12,
    },
}


/// General type information struct for types that have a known size.
struct McSizedTypeInfo {
    /// Size in bytes of the type.
    ///
    /// ### Note:
    /// To get the size in bits, multiply the constant by 8.
    size: int @ 1..,

    ...McTypeInfo,
}


/// Struct type for integer data type constants.
type McIntegerTypeInfo<T> = struct {
    /// Minimum value.
    min: T,

    /// Maximum value.
    max: T,

    ...McSizedTypeInfo,
}


/// Struct type for constants of integer data types that can be used in number
/// arrays.
struct McArrayTypeInfo {
    /// Character that indicates the type of number arrays of this type.
    type_indicator: enum(string) ArrayTypeIndicator {
        /// `byte` number array indicator.
        Byte = "B",

        /// `int` number array indicator.
        Int = "I",

        /// `long` number array indicator.
        Long = "L",
    },

    ...McTypeInfo,
}


/// Struct type for floating-point data type constants.
type McFloatingTypeInfo<T> = struct {
    /// Minimum value.
    min: T,

    /// Maximum value.
    max: T,

    /// Smallest positive non-zero value.
    positive_epsilon: T,

    /// Smallest negative non-zero value.
    negative_epsilon: T,

    ...McSizedTypeInfo,
}
